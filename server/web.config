<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the compiled API under IIS on SmarterASP.NET via httpPlatformHandler.
  Deploy to a folder that has Node enabled in the control panel (e.g. /api),
  upload dist/ + node_modules/ + package.json + .env alongside this file.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node"
                  arguments="dist/index.js"
                  startupTimeLimit="30"
                  startupRetryCount="3"
                  stdoutLogEnabled="true"
                  stdoutLogFile="./logs/api.log">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
