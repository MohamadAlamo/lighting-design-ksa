# Telegram.
# BOT_TOKEN comes from @BotFather (/mybots -> your bot -> API Token) and looks
# like <bot-id>:<35-character-secret>. Left blank on purpose: a realistic-looking
# dummy here trips GitHub's secret scanner on every push.
# INSTALL_CHAT_ID is the destination group, e.g. -1001234567890 for a supergroup.
BOT_TOKEN=
INSTALL_CHAT_ID=

# Admin secret for minting form links (send as x-admin-secret header)
ADMIN_SECRET=change-me-to-a-long-random-string

# Public site origin, used to build form links and for CORS
PUBLIC_ORIGIN=https://lightingdesign-ksa.com

# Where the site should send the customer after a successful submit
REDIRECT_URL=https://lightingdesign-ksa.com/

PORT=8080

# Optional. Where the single-use form links are stored. Defaults to data/tokens.json
# beside the app; a relative value resolves against the app folder, not the cwd.
# TOKEN_STORE=data/tokens.json

# Any long random string, e.g. `openssl rand -hex 24`. Shared with Telegram
# by `npm run webhook:set` and verified on every incoming update.
TELEGRAM_WEBHOOK_SECRET=
